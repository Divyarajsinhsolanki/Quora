<div class="card text-white bg-secondary mb-3" style="margin:30px;">
  <div style="align-items:center;">
    <div class="card-header">
    <%= render partial: "layouts/new_room_form" %>
    </div>
  <div class="card-body">
    <%= turbo_stream_from "rooms" %>
      <div id="rooms" class="btn btn-success">
      <%= render @rooms %>
    <div>
  </div>

  </div>
</div>

<div class="col-md-10 text-light">
  <% if @single_room %>

    <h4 class="color:red;"> <%= @single_room.name %> </h4>
      <%= turbo_stream_from @single_room %>
      <%= render @messages %>
      
      <div id="messages">
      </div>

    <%= render partial: 'layouts/new_message_form' %>

  <% end %>
</div>