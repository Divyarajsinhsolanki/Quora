<!DOCTYPE html>
<html>
  <head>
  <title> Quora </title>
  

  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link href="img/favicon.ico" rel="icon">
  <%= favicon_link_tag asset_path('img32.png') %>  

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= action_cable_meta_tag %>
    <%= javascript_include_tag :application %>
    <%= javascript_include_tag Ckeditor.cdn_url %>
    <%= javascript_include_tag 'https://checkout.stripe.com/checkout.js' %>
    <%= turbo_stream_from "streams"  %>
    <script src="https://js.stripe.com/v3/"></script>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "cubism.umd.min.js", "data-turbo-track": "reload" %>

  </head>
<style>
  <%= ".msg-#{current_user&.id}" %> {
  background-color: #25d366 !important;
  color: black;
  padding: 10px;
  }
  <%= ".cont-#{current_user&.id}" %> {
  display: flex;
  color: black;
  justify-content: flex-end
  }
</style>
  <body  class="d-flex flex-column">

      <%= render 'layouts/header'  %>
      <% flash.each do |key, value| %>
        <div class="<%= key %>" style="margin-top:30px;"><%= value %></div>
      <% end %>
    <%= yield %>

  <footer class="navbar fixed-bottom navbar-inverse  bg-dark"></footer>
  </body>
</html>