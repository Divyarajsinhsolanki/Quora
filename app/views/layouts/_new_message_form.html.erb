<div class="form-group msg-form">
<%= form_with(model: [@single_room ,@message], class: "d-flex", id: "new_message", data: { controller: "reset-form", action: "turbo:submit-end->reset-form#reset" }) do |f| %>
    <%= f.text_field :content, id: 'msg', class: "form-control msg-content", autocomplete: 'off', maxLength: 50 %>
  <%= f.submit data: { disable_with: false }, class: "btn btn-primary" %>
  <% end %>
</div>
<%= turbo_stream.replace "form" do %>
<% end %>


